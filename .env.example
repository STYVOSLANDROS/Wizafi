# Copie ce fichier en .env et adapte les valeurs. .env n'est jamais commité (voir .gitignore).

# Nom de l'application, affiché dans l'UI (dashboard, page d'achat).
APP_NAME=WIZAFI

# Domaine public de cette installation (sans slash final) — utilisé pour
# générer les instructions de Walled Garden (spec §7). En développement
# local, laisse la valeur par défaut.
APP_DOMAIN="http://localhost:3000"

# Connexion à la base PostgreSQL démarrée par docker-compose.yml (service "db").
# Format : postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://wizafi:wizafi_dev_password@localhost:5432/wizafi?schema=public"

# --- MikroTik (Phase 1) ---
# En développement, le routeur est sur le réseau local : ni CGNAT ni tunnel à
# gérer avant la Phase 7 (spec §3). Compte API dédié, jamais le compte admin
# (spec §3 et guide de démarrage §6.2).
MIKROTIK_BASE_URL="https://192.168.88.1/rest"
MIKROTIK_API_USERNAME="wizafi-api"
MIKROTIK_API_PASSWORD="change-me"

# Le certificat du MikroTik est auto-signé en développement local : mets ceci
# à "true" uniquement dans ton .env local, jamais en production (spec §3, §8).
MIKROTIK_INSECURE_TLS="true"

# Optionnel : nom du profil hotspot utilisé par `npm run test:mikrotik` pour
# créer un utilisateur de test. Par défaut, le script prend le premier profil
# de la liste renvoyée par le MikroTik.
# MIKROTIK_TEST_PROFILE="1heure"

# --- Chiffrement (spec §8) ---
# Clé maîtresse pour chiffrer les secrets stockés en base (mot de passe API
# des routeurs, etc.). Génère la tienne avec : openssl rand -base64 32
# Ne JAMAIS réutiliser la valeur de démonstration ci-dessous en production.
ENCRYPTION_KEY="RoYtPtXn24J/nQarfn0ZUjiYkexrEEBcv3kG/OLl9gA="

# --- Authentification du gérant (Phase 2, Auth.js) ---
# Clé de signature des sessions. Génère la tienne avec : openssl rand -base64 32
AUTH_SECRET="cLUNP2TSP3RjCnK3EnTcUinvTZWw3za0Lph1d6etfPI="

# Optionnel : identifiants OAuth Google (console.cloud.google.com → API et
# services → Identifiants). Si absents, le bouton "Continuer avec Google" ne
# s'affiche simplement pas — email/mot de passe fonctionne sans eux.
# AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="xxxxxxxx"

# --- CamPay (Phase 3) ---
# Sandbox : https://demo.campay.net/api — Production : https://campay.net/api
# Identifiants du compte marchand CamPay (dossier "APP KEYS" sur leur
# dashboard). Non vérifiés en profondeur dans ce sandbox — voir la note en
# tête de lib/payments/campay.ts avant la mise en production.
CAMPAY_BASE_URL="https://demo.campay.net/api"
CAMPAY_USERNAME="change-me"
CAMPAY_PASSWORD="change-me"

# --- Transaction (spec §5) ---
# Délai avant qu'un paiement non confirmé passe en PAYMENT_EXPIRED.
TRANSACTION_EXPIRY_MINUTES="15"

# --- Retraits (spec §1BIS) ---
# Seuil minimum pour éviter les micro-retraits.
PAYOUT_MINIMUM_AMOUNT="1000"
