# Copie ce fichier en .env et adapte les valeurs. .env n'est jamais commité (voir .gitignore).

# Nom de l'application, affiché dans l'UI (dashboard, page d'achat).
APP_NAME=WIZAFI

# Connexion à la base PostgreSQL démarrée par docker-compose.yml (service "db").
# Format : postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://wizafi:wizafi_dev_password@localhost:5432/wizafi?schema=public"

# --- MikroTik (Phase 1) ---
# En développement, le routeur est sur le réseau local : ni CGNAT ni tunnel à
# gérer avant la Phase 7 (spec §3). Compte API dédié, jamais le compte admin
# (spec §3 et guide de démarrage §6.2).
MIKROTIK_BASE_URL="https://192.168.88.1/rest"
MIKROTIK_API_USERNAME="wizafi-api"
MIKROTIK_API_PASSWORD="change-me"

# Le certificat du MikroTik est auto-signé en développement local : mets ceci
# à "true" uniquement dans ton .env local, jamais en production (spec §3, §8).
MIKROTIK_INSECURE_TLS="true"

# Optionnel : nom du profil hotspot utilisé par `npm run test:mikrotik` pour
# créer un utilisateur de test. Par défaut, le script prend le premier profil
# de la liste renvoyée par le MikroTik.
# MIKROTIK_TEST_PROFILE="1heure"
